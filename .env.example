APP_ENV=development
LOG_LEVEL=INFO
API_PORT=8000
POSTGRES_DB=panscience
POSTGRES_USER=panscience
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://panscience:change-me@localhost:5432/panscience
REDIS_URL=redis://localhost:6379/0
ALLOWED_EXTENSIONS=[".mp4", ".mov", ".mkv", ".webm", ".avi"]
MAX_UPLOAD_SIZE_MB=500
MAX_DURATION_SECONDS=3600
PROCESSING_TIMEOUT_SECONDS=3600
MAX_RETRIES=2
WORKER_CONCURRENCY=2
PROVIDER_DIARIZATION=demo
PROVIDER_SPEECH_TO_TEXT=demo
STT_PROVIDER=demo
WHISPER_MODEL_SIZE=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
PROVIDER_TRANSLATION=demo
PROVIDER_TEXT_TO_SPEECH=demo
PROVIDER_STORAGE=local
STORAGE_ROOT=./storage
